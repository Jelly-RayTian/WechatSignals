{
  "name": "wechat-signals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run build && electron .",
    "preview": "vite --host 127.0.0.1",
    "build:keychain": "swiftc native/Keychain.swift -o native/keychain-helper",
    "audit:scoring": "tsx scripts/audit-scoring.ts",
    "evaluate:jev": "tsx scripts/evaluate-jev.ts",
    "evaluate:jev:v9": "tsx scripts/evaluate-jev.ts --with-attribution --with-dialogue"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^38.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
